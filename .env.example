# Copy to .env (chmod 600). Never commit .env.
TZ=Africa/Lagos
PUID=1000
PGID=1000
SERVER_IP=192.168.1.100
APPDATA=/opt/appdata
DATA=/data
# gid of the host's docker group: getent group docker | cut -d: -f3
DOCKER_GID=999

# API keys: fill in after first start, from each app's Settings -> General
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
SEERR_API_KEY=

# qBittorrent web UI login (Homepage widget)
QBT_USER=admin
QBT_PASS=CHANGE_ME

# WUD (image update checker) admin login. It will not start without one.
WUD_USER=admin
WUD_PASS=CHANGE_ME

# Extra hostnames Homepage should accept (e.g. your Tailscale name), comma-separated
HOMEPAGE_EXTRA_HOSTS=
